# 24.10 OpenWrt：WR30U 首次启动 UCI 配置

# 自动重启（/etc/config/autoreboot）
uci set autoreboot.cfg016bf2.enabled='1'
uci set autoreboot.cfg016bf2.week='3'
uci set autoreboot.cfg016bf2.hour='9'
uci commit autoreboot

# 防火墙：LAN / WAN 区域，wwan 属于 WAN（/etc/config/firewall）
uci del firewall.cfg02dc81.network
uci add_list firewall.cfg02dc81.network='lan'
uci del firewall.cfg03dc81.network
uci add_list firewall.cfg03dc81.network='wan'
uci add_list firewall.cfg03dc81.network='wan6'
uci add_list firewall.cfg03dc81.network='wwan'
uci commit firewall

# 中继网络：wwan 通过 DHCP 获取上游地址（/etc/config/network）
uci set network.wwan=interface
uci set network.wwan.proto='dhcp'
uci commit network

# 无线配置（/etc/config/wireless）
# MT7981_1_1 = 2.4 GHz 无线设备；MT7981_1_2 = 5 GHz 无线设备。
# default_ 开头的段为本机热点（AP），供手机等设备连接。
# wifinet2 为上游中继（STA），所属频段由它的 device 配置决定。

# 2.4 GHz：设备参数（MT7981_1_1）
uci set wireless.MT7981_1_1.htmode='HT40'
uci set wireless.MT7981_1_1.channel='auto'

# 2.4 GHz：本机热点（default_MT7981_1_1）
uci set wireless.default_MT7981_1_1.ssid='H2G'
uci set wireless.default_MT7981_1_1.encryption='sae-mixed'
uci set wireless.default_MT7981_1_1.key='88888888..'
# 可选：取消下一行注释以隐藏此热点名称。
# uci set wireless.default_MT7981_1_1.hidden='1'

# 2.4 GHz：上游中继（wifinet2 绑定 MT7981_1_1，接入 wwan）
uci set wireless.wifinet2=wifi-iface
uci set wireless.wifinet2.device='MT7981_1_1'
uci set wireless.wifinet2.mode='sta'
uci set wireless.wifinet2.network='wwan'
uci set wireless.wifinet2.ssid='1309'
uci set wireless.wifinet2.encryption='psk2'
uci set wireless.wifinet2.key='13409941080'

# 5 GHz：设备参数（MT7981_1_2）
uci set wireless.MT7981_1_2.htmode='HE80'
uci set wireless.MT7981_1_2.channel='36'
uci del wireless.MT7981_1_2.noscan

# 5 GHz：本机热点（default_MT7981_1_2）
uci set wireless.default_MT7981_1_2.ssid='H'
uci set wireless.default_MT7981_1_2.encryption='sae-mixed'
uci set wireless.default_MT7981_1_2.key='88888888..'
# 可选：取消下一行注释以隐藏此热点名称。
# uci set wireless.default_MT7981_1_2.hidden='1'

# 统一保存以上无线配置。
uci commit wireless

# 网络指示灯：关联中继接口 apcli0（/etc/config/system）
uci set system.led_network.dev='apcli0'
uci del system.led_network.mode
uci add_list system.led_network.mode='link'
uci commit system

# 消息中显示的设备名称（/etc/config/wechatpush）
uci set wechatpush.config.device_name='WR30U'
uci commit wechatpush
