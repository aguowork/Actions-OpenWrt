# ============================================================================
# fanchmwrt-25.12.4 | Qihoo 360 T7
#
# 本文件由 25.12.4 工作流直接加载为 OpenWrt 的 .config，
# 不依赖源码中的 defconfig 文件（25.12.4 源码没有本工作流用的 defconfig，
# 原来注释里写的"追加到 defconfig/mt7981-ax3000.config 之后"已经不成立）。
#
# 配置说明：
# 1. 保留本设备的 TARGET/DEVICE 配置，确保选择正确的硬件目标。
# 2. 在下方添加需要内置的软件包和其他编译选项。
# 3. 修改完成后，在 OpenWrt 源码目录执行：
#
#      make defconfig
#      ./scripts/diffconfig.sh > diffconfig
#
# diffconfig 可用于查看 make defconfig 后的精简配置，
# 后续适配时可将确认过的配置同步回本文件。
# ============================================================================

# 设备目标配置
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# 语言设置 - 中文简体界面
CONFIG_LUCI_LANG_zh_Hans=y

# 插件配置
# AdGuardHome：用 luci feed 自带的官方 luci-app-adguardhome（JS 页面），
# 它硬依赖 +adguardhome，主程序会被编进固件（官方 apk 约 10.8 MiB）。
# 服务默认就是 enable 的（打包时生成 /etc/rc.d/S19adguardhome，开机等 interface.*.up 触发后启动），
# 包里不带 adguardhome.yaml（只把它列进 conffiles），所以在
# files/25.12/fanchmwrt/etc/adguardhome/adguardhome.yaml 预置了一份"只要查询日志、
# 不做拦截"的配置，开机即用，不必再去 :3000 跑安装向导。
# :3000 的登录账号同样预置在那份 yaml 的 users: 里（root + bcrypt 哈希），换密码见 yaml 末尾。
# 配套的 files/25.12/fanchmwrt/etc/uci-defaults/99-adguardhome-dns 把 53 端口让给
# AdGuardHome、dnsmasq 退到 5353：客户端必须直连 AdGuardHome，查询日志才认得出是哪台设备。
# 官方版 /etc/config/adguardhome 没有 option enabled，别照 ddnsto/wbzt 那样 sed 改 enabled。
# adguardhome 是被 select 进来的，此处显式声明便于查阅体积来源。
# 官方版没有中文 po（只有老挝语），不要加 luci-i18n-adguardhome-zh-cn，那是死行；
# AdGuardHome 自己 :3000 的管理界面仍是中文，日常配置在那边做。
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y
# 定时重启 / 断网自动重启。25.12 源码里已经没有 luci-app-autoreboot，
# 用 watchcat 替代（luci-app-watchcat 自带 +watchcat 依赖，不用单独写）
CONFIG_PACKAGE_luci-app-watchcat=y
# 已删掉从 24.10 抄来的死行：luci-app-arpbind / luci-app-autoreboot / luci-app-vlmcsd
# 这三个包在 25.12 的 feeds 里不存在，make defconfig 会静默丢弃，别再加回来
# ZeroTier 备用：25.12 源码里同样没有 luci-app-zerotier，取消注释也不会生效
#CONFIG_PACKAGE_luci-app-zerotier=y

# 微信推送（wrtbwmon 由 _Enable_Traffic_Monitoring 自动 select，此处显式声明便于查阅）
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_wrtbwmon=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y

# 透明代理：本设备默认不装。25.12 的 feeds 里没有 OpenClash，
# 要用就照 AX6000 那样开 Nikki/Mihomo（diy-part1.sh 已经加了 nikki feed）：
#CONFIG_PACKAGE_luci-app-nikki=y
#CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# 依赖配置（etc/JiaoBen 下的脚本直接调用，不靠其它插件的依赖搭便车）
# files/25.12 这套脚本三个设备共用，所以三份配置都要带上
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils-shuf=y
CONFIG_PACKAGE_coreutils-base64=y
# 不需要 git/git-http：www 的"检查更新"已改成 HTTP 拉 Gitee 归档（见 wx-auth.sh 的 http_download）

# ============================================================================
# 主题：使用 fanchmwrt 自家主题
# luci-theme-fanchmwrt 已由源码 DEFAULT_PACKAGES.router 内置，并且它的
# uci-defaults 会把 luci.main.mediaurlbase 指向自己，开箱即为生效主题，
# 所以这里不需要任何主题配置。bootstrap 由 luci -> luci-light 自动带入兜底。
# 原先那行 CONFIG_PACKAGE_luci-theme-bootstrap=y 与 argon/material/openwrt
# 的 "is not set" 都已删除：前者由 luci-light 自动带入，后者的包在 25.12 里不存在。
# ============================================================================

# ============================================================================
# 精简：以下包由源码 include/target.mk 的 DEFAULT_PACKAGES.router 默认内置，
# 在这里显式关闭。
# 原理：内置包在 kconfig 里表现为 "default y if DEFAULT_xxx"，属于默认值，
# 可以被 "is not set" 覆盖；若某个包是别人的硬依赖（DEPENDS:=+xxx），
# make defconfig 会自动把它拉回来，不会编译失败。
# ============================================================================

# 360T7 没有 USB 口，接不了外置存储，整套挂载/文件系统/共享移除
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-ksmbd is not set
# CONFIG_PACKAGE_block-mount is not set

# CPU 跑分工具，用不到
# CONFIG_PACKAGE_coremark is not set

# 动态域名解析：无线中继模式拿不到公网 IP，远程访问走 ddnsto
# （连带移除 ddns-scripts）
# CONFIG_PACKAGE_luci-app-ddns is not set

# UPnP 自动端口映射：中继模式下上游网关不是本机，映射不生效；
# 游戏 NAT 类型由默认内置的 kmod-nft-fullcone 处理（连带移除 miniupnpd）
# CONFIG_PACKAGE_luci-app-upnp is not set

# ============================================================================
# 以下默认内置包必须保留，不要再加 "is not set"（备忘，防止以后误删）：
#   luci-app-fwx-*    应用中心 / 上网行为管理 / 仪表盘全套，fanchmwrt 特性。
#                     25.12 没有 OAF（open-app-filter/appfilter/kmod-oaf），
#                     不要从 24.10 的配置里搬过来，搬了也是死配置。
#   luci-app-uhttpd   uhttpd 配置页面，本次确认保留
#   uhttpd            www/wx 网页和 www/cgi-bin/wx-auth.sh 全靠它，必留
#   dnsmasq-full      以后开 nikki 要靠它的 nftset 支持
#   kmod-tun / kmod-nft-tproxy / kmod-nft-socket / ip-full   同上，透明代理用
#   ppp / ppp-mod-pppoe          PPPoE 拨号上网备用
#   wpad-basic-mbedtls           无线中继必需
#   kmod-nf-conntrack-netlink    wrtbwmon 流量统计
# ============================================================================
