# ============================================================================
# fanchmwrt-25.12.4 | Xiaomi Redmi Router AX6000
# 本文件被 25.12.4 工作流直接当作 OpenWrt 的 .config 加载，不用源码里的 defconfig。
# 想看精简后的结果：源码目录执行 make defconfig && ./scripts/diffconfig.sh > diffconfig
# ============================================================================

# 设备目标
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y

# 中文简体界面
CONFIG_LUCI_LANG_zh_Hans=y

# ----------------------------------------------------------------------------
# 插件
# ----------------------------------------------------------------------------
# AdGuardHome：luci feed 自带的官方版（JS 页面），硬依赖 +adguardhome（约 10.8 MiB，
#   下面显式写出来便于查体积来源）。服务打包时已 enable，但包里不带 adguardhome.yaml，
#   所以 files/25.12/fanchmwrt/etc/adguardhome/adguardhome.yaml 预置了一份"只记查询
#   日志、不拦截"的配置和 :3000 账号（root + bcrypt，改密码见 yaml 末尾），开机即用。
#   配套 etc/uci-defaults/99-adguardhome-dns 把 53 让给 AGH、dnsmasq 退 5353——
#   客户端直连 AGH，查询日志才认得出是哪台设备。
#   两个坑：官方版 /etc/config/adguardhome 没有 option enabled，别学 ddnsto/wbzt 去 sed；
#   官方版没有中文 po，luci-i18n-adguardhome-zh-cn 是死行（:3000 界面本身是中文）。
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y
# 定时重启 / 断网重启，替代 25.12 已不存在的 luci-app-autoreboot（自带 +watchcat）
CONFIG_PACKAGE_luci-app-watchcat=y

# 微信推送（wrtbwmon 由 _Enable_Traffic_Monitoring 自动 select，显式写出便于查阅）
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_wrtbwmon=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y

# 透明代理：只用 Nikki/Mihomo，feed 由本设备的 diy-part1.sh 加入（另两台没加）
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# 脚本依赖：etc/JiaoBen 下的脚本直接调用，不靠别的插件搭便车。files/25.12 这套脚本
# 三个设备共用，所以三份配置都要带上。不需要 git/git-http——"检查更新"已改成
# HTTP 拉 Gitee 归档（见 wx-auth.sh 的 http_download）。
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils-shuf=y
CONFIG_PACKAGE_coreutils-base64=y

# 主题：luci-theme-fanchmwrt 已由源码 DEFAULT_PACKAGES.router 内置，它的 uci-defaults
# 会把 luci.main.mediaurlbase 指向自己，开箱即生效，这里不用写任何主题配置。

# ----------------------------------------------------------------------------
# 精简：以下包由源码 include/target.mk 的 DEFAULT_PACKAGES.router 默认内置，
# 内置表现为 "default y if DEFAULT_xxx"，属于默认值，可以被 "is not set" 覆盖；
# 若某个包是别人的硬依赖（DEPENDS:=+xxx），make defconfig 会自动拉回，不会编译失败。
# ----------------------------------------------------------------------------

# AX6000 没有 USB 口，接不了外置存储，整套挂载/文件系统/共享移除
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-ksmbd is not set
# CONFIG_PACKAGE_block-mount is not set

# CPU 跑分工具，用不到
# CONFIG_PACKAGE_coremark is not set

# 动态域名解析：无线中继拿不到公网 IP，远程访问走 ddnsto（连带移除 ddns-scripts）
# CONFIG_PACKAGE_luci-app-ddns is not set

# UPnP 端口映射：中继模式下上游网关不是本机，映射不生效；游戏 NAT 类型由默认内置的
# kmod-nft-fullcone 处理（连带移除 miniupnpd）
# CONFIG_PACKAGE_luci-app-upnp is not set

# ----------------------------------------------------------------------------
# 备忘 1 - 这些包 25.12 的 feeds 里没有，从 24.10 抄过来就是死行，别再加：
#   luci-app-arpbind / luci-app-autoreboot / luci-app-vlmcsd / luci-app-zerotier
#   luci-app-openclash、OAF 全套（open-app-filter / appfilter / kmod-oaf）
#   luci-theme-argon / material / openwrt
#
# 备忘 2 - 这些默认内置包必须保留，别再加 "is not set"：
#   luci-app-fwx-*    应用中心 / 上网行为管理 / 仪表盘全套，fanchmwrt 特性
#   luci-app-uhttpd / uhttpd     www/wx 网页和 www/cgi-bin/wx-auth.sh 全靠它
#   dnsmasq-full      nikki 要靠它的 nftset 支持；也是 DNS/DHCP 核心
#   kmod-tun / kmod-nft-tproxy / kmod-nft-socket / ip-full   nikki 透明代理
#   luci-theme-fanchmwrt         生效主题（bootstrap 由 luci -> luci-light 兜底）
#   ppp / ppp-mod-pppoe          PPPoE 拨号上网备用
#   wpad-basic-mbedtls           无线中继必需
#   kmod-nf-conntrack-netlink    wrtbwmon 流量统计
# ----------------------------------------------------------------------------
