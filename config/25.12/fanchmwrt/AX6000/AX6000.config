# ============================================================================
# fanchmwrt-25.12.4 | Xiaomi Redmi Router AX6000
#
# 本文件由 25.12.4 工作流直接加载为 OpenWrt 的 .config，
# 不依赖源码中的 defconfig 文件。
#
# 配置说明：
# 1. 保留本设备的 TARGET/DEVICE 配置，确保选择正确的硬件目标。
# 2. 在下方添加需要内置的软件包和其他编译选项。
# 3. 修改完成后，在 OpenWrt 源码目录执行：
#
#      make defconfig
#      ./scripts/diffconfig.sh > diffconfig
#
# diffconfig 可用于查看 make defconfig 后的精简配置，
# 后续适配时可将确认过的配置同步回本文件。
# ============================================================================

# 设备目标配置
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y


# 语言设置 - 中文简体界面
CONFIG_LUCI_LANG_zh_Hans=y

# 插件配置
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y
CONFIG_PACKAGE_luci-app-wol=y
#CONFIG_PACKAGE_luci-app-zerotier=y

# 透明代理只启用 Nikki/Mihomo，避免与 OpenClash 同时接管 DNS 和防火墙
# CONFIG_PACKAGE_luci-app-openclash is not set
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y


# 依赖配置
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils-shuf=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_git-http=y

# openwrt主题配置（只保留 bootstrap）
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-openwrt is not set
# CONFIG_PACKAGE_luci-theme-openwrt-2020 is not set

