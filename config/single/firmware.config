# ============================================
# 360T7 自定义配置文件（108 MiB 扩容分区）
# 此配置会追加到 defconfig/mt7981-ax3000.config 之后
# 只需要包含额外添加的插件和自定义配置
# ============================================

# ImmortalWrt 21.02：仅构建 360T7 的 108 MiB 扩容分区固件
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_mediatek_mt7981_DEVICE_mt7981-360-t7-108M=y



# 语言设置 - 中文简体界面
CONFIG_LUCI_LANG_zh_Hans=y

# 插件配置
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-zerotier=y

# 透明代理
CONFIG_PACKAGE_luci-app-ssr-plus=y


# 依赖配置
CONFIG_PACKAGE_coreutils-shuf=y
CONFIG_PACKAGE_coreutils-base64=y

